# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# For local development: postgresql://postgres:password@localhost:5432/firewall_dashboard
DATABASE_URL=postgresql://postgres:password@localhost:5432/firewall_dashboard

# Server Configuration
PORT=5001

# Frontend URL (optional, defaults to *)
FRONTEND_URL=http://localhost:3000

# Admin Code (optional, defaults to "admin123")
ADMIN_CODE=admin123

# Seed Data (optional, set to "true" to seed sample devices on first run)
SEED_DATA=false
